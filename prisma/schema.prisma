generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & RBAC ───────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES
  WAREHOUSE
  ACCOUNTANT
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  products           Product[]
  categories         Category[]
  suppliers          Supplier[]
  customers          Customer[]
  warehouses         Warehouse[]
  purchases          Purchase[]
  sales              Sale[]
  invoices           Invoice[]
  expenses           Expense[]
  leads              Lead[]
  deals              Deal[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  files              FileUpload[]

  @@map("organizations")
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  avatar         String?
  role           UserRole   @default(VIEWER)
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       Session[]
  refreshTokens  RefreshToken[]
  activityLogs   ActivityLog[]
  notes          Note[]
  reminders      Reminder[]
  notifications  Notification[]
  stockMovements StockMovement[] @relation("StockMovementUser")
  dispatches     Dispatch[]      @relation("DispatchUser")
  receivings     Receiving[]     @relation("ReceivingUser")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       Json     @default("{}")
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@map("activity_logs")
}

// ─── ERP: Products & Categories ──────────────────────────────

enum ProductStatus {
  ACTIVE
  DISCONTINUED
  DRAFT
}

model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  parentId       String?
  image          String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryTree")
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("categories")
}

model Product {
  id             String        @id @default(cuid())
  organizationId String
  categoryId     String?
  sku            String
  barcode        String?
  name           String
  description    String?
  brand          String?
  color          String?
  size           String?
  material       String?
  costPrice      Decimal       @default(0) @db.Decimal(12, 2)
  sellPrice      Decimal       @default(0) @db.Decimal(12, 2)
  wholesalePrice Decimal       @default(0) @db.Decimal(12, 2)
  minStock       Int           @default(0)
  maxStock       Int?
  weight         Decimal?      @db.Decimal(10, 3)
  images         String[]      @default([])
  status         ProductStatus @default(ACTIVE)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id])
  inventoryItems InventoryItem[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  invoiceItems   InvoiceItem[]
  transferItems  TransferItem[]
  dispatchItems  DispatchItem[]
  receivingItems ReceivingItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, status])
  @@index([barcode])
  @@map("products")
}

// ─── ERP: Suppliers & Purchases ────────────────────────────────

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  code           String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  taxId          String?
  paymentTerms   Int            @default(30)
  status         SupplierStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases    Purchase[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model Purchase {
  id             String         @id @default(cuid())
  organizationId String
  supplierId     String
  purchaseNumber String
  status         PurchaseStatus @default(DRAFT)
  orderDate      DateTime       @default(now())
  expectedDate   DateTime?
  receivedDate   DateTime?
  subtotal       Decimal        @default(0) @db.Decimal(12, 2)
  tax            Decimal        @default(0) @db.Decimal(12, 2)
  total          Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  items        PurchaseItem[]
  receivings   Receiving[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId, status])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Decimal @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@map("purchase_items")
}

// ─── ERP: Sales & Invoices ─────────────────────────────────────

enum SaleStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Sale {
  id             String     @id @default(cuid())
  organizationId String
  customerId     String
  saleNumber     String
  status         SaleStatus @default(DRAFT)
  orderDate      DateTime   @default(now())
  shipDate       DateTime?
  subtotal       Decimal    @default(0) @db.Decimal(12, 2)
  discount       Decimal    @default(0) @db.Decimal(12, 2)
  tax            Decimal    @default(0) @db.Decimal(12, 2)
  total          Decimal    @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  items        SaleItem[]
  invoices     Invoice[]
  dispatches   Dispatch[]

  @@unique([organizationId, saleNumber])
  @@index([organizationId, status])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String
  saleId         String?
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  paidDate       DateTime?
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id])
  sale         Sale?         @relation(fields: [saleId], references: [id])
  items        InvoiceItem[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MARKETING
  SHIPPING
  SUPPLIES
  OTHER
}

model Expense {
  id             String          @id @default(cuid())
  organizationId String
  category       ExpenseCategory
  description    String
  amount         Decimal         @db.Decimal(12, 2)
  date           DateTime        @default(now())
  receiptUrl     String?
  vendor         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@map("expenses")
}

// ─── CRM ───────────────────────────────────────────────────────

enum CustomerType {
  RETAIL
  WHOLESALE
  VIP
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Customer {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  code           String
  email          String?
  phone          String?
  company        String?
  type           CustomerType   @default(WHOLESALE)
  status         CustomerStatus @default(ACTIVE)
  address        String?
  city           String?
  country        String?
  taxId          String?
  creditLimit    Decimal        @default(0) @db.Decimal(12, 2)
  balance        Decimal        @default(0) @db.Decimal(12, 2)
  tags           String[]       @default([])
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        Sale[]
  invoices     Invoice[]
  deals        Deal[]
  notes        Note[]
  activities   CustomerActivity[]
  communications Communication[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("customers")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  TRADE_SHOW
  COLD_CALL
  SOCIAL
  OTHER
}

model Lead {
  id             String     @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  company        String?
  status         LeadStatus @default(NEW)
  source         LeadSource @default(OTHER)
  score          Int        @default(0)
  notes          String?
  assignedTo     String?
  convertedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@index([organizationId, status])
  @@map("leads")
}

enum DealStage {
  PROSPECT
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model Deal {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  leadId         String?
  title          String
  value          Decimal   @default(0) @db.Decimal(12, 2)
  stage          DealStage @default(PROSPECT)
  probability    Int       @default(10)
  expectedClose  DateTime?
  closedAt       DateTime?
  assignedTo     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId, stage])
  @@map("deals")
}

model Note {
  id         String   @id @default(cuid())
  customerId String?
  dealId     String?
  userId     String
  content    String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@map("notes")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  VISIT
  ORDER
  PAYMENT
  NOTE
  OTHER
}

model CustomerActivity {
  id          String       @id @default(cuid())
  customerId  String
  type        ActivityType
  title       String
  description String?
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("customer_activities")
}

enum CommunicationChannel {
  EMAIL
  PHONE
  SMS
  WHATSAPP
  IN_PERSON
}

model Communication {
  id         String               @id @default(cuid())
  customerId String
  channel    CommunicationChannel
  subject    String?
  content    String
  direction  String               @default("outbound")
  createdAt  DateTime             @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("communications")
}

model Reminder {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  dueAt       DateTime
  completed   Boolean  @default(false)
  entityType  String?
  entityId    String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@map("reminders")
}

// ─── WMS ───────────────────────────────────────────────────────

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Warehouse {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  country        String?
  status         WarehouseStatus @default(ACTIVE)
  capacity       Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zones          Zone[]
  inventoryItems InventoryItem[]
  transfersFrom  Transfer[]      @relation("TransferFrom")
  transfersTo    Transfer[]      @relation("TransferTo")
  dispatches     Dispatch[]
  receivings     Receiving[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

model Zone {
  id          String   @id @default(cuid())
  warehouseId String
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  shelves   Shelf[]

  @@unique([warehouseId, code])
  @@map("zones")
}

model Shelf {
  id        String   @id @default(cuid())
  zoneId    String
  name      String
  code      String
  capacity  Int?
  createdAt DateTime @default(now())

  zone           Zone            @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([zoneId, code])
  @@map("shelves")
}

model InventoryItem {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  shelfId     String?
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  shelf     Shelf?    @relation(fields: [shelfId], references: [id])

  @@unique([productId, warehouseId, shelfId])
  @@index([warehouseId])
  @@index([productId])
  @@map("inventory_items")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  RESERVE
  RELEASE
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  warehouseId String
  type        StockMovementType
  quantity    Int
  reference   String?
  notes       String?
  userId      String?
  createdAt   DateTime          @default(now())

  user User? @relation("StockMovementUser", fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@map("stock_movements")
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Transfer {
  id              String         @id @default(cuid())
  transferNumber  String         @unique
  fromWarehouseId String
  toWarehouseId   String
  status          TransferStatus @default(PENDING)
  notes           String?
  shippedAt       DateTime?
  receivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  fromWarehouse Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         TransferItem[]

  @@index([status])
  @@map("transfers")
}

model TransferItem {
  id         String @id @default(cuid())
  transferId String
  productId  String
  quantity   Int

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@map("transfer_items")
}

enum DispatchStatus {
  PENDING
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Dispatch {
  id             String         @id @default(cuid())
  dispatchNumber String         @unique
  saleId         String?
  warehouseId    String
  status         DispatchStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  userId         String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sale      Sale?          @relation(fields: [saleId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  user      User?          @relation("DispatchUser", fields: [userId], references: [id])
  items     DispatchItem[]

  @@index([status])
  @@map("dispatches")
}

model DispatchItem {
  id         String @id @default(cuid())
  dispatchId String
  productId  String
  quantity   Int
  picked     Int    @default(0)

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([dispatchId])
  @@map("dispatch_items")
}

enum ReceivingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Receiving {
  id              String          @id @default(cuid())
  receivingNumber String          @unique
  purchaseId      String?
  warehouseId     String
  status          ReceivingStatus @default(PENDING)
  receivedAt      DateTime?
  userId          String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  purchase  Purchase?       @relation(fields: [purchaseId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  user      User?           @relation("ReceivingUser", fields: [userId], references: [id])
  items     ReceivingItem[]

  @@index([status])
  @@map("receivings")
}

model ReceivingItem {
  id          String @id @default(cuid())
  receivingId String
  productId   String
  expectedQty Int
  receivedQty Int    @default(0)

  receiving Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([receivingId])
  @@map("receiving_items")
}

// ─── System ────────────────────────────────────────────────────

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  LOW_STOCK
  DEAL_UPDATE
  INVOICE_DUE
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType @default(INFO)
  title          String
  message        String
  read           Boolean          @default(false)
  link           String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model FileUpload {
  id             String   @id @default(cuid())
  organizationId String
  filename       String
  originalName   String
  mimeType       String
  size           Int
  url            String
  entityType     String?
  entityId       String?
  uploadedBy     String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
  @@map("file_uploads")
}
